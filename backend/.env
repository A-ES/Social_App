# Environment (development, production, etc.)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Required)
MONGODB_URI=mongodb://localhost:27017/opus_db

# JWT Secret Key for Authentication (Required)
JWT_SECRET=your_super_secret_jwt_key_here

# JWT Expiration Time (Optional, defaults to 7d)
JWT_EXPIRES_IN=7d

# Allowed CORS Origin (Optional, defaults to http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Maximum File Upload Size in MB (Optional, defaults to 5)
MAX_FILE_SIZE_MB=5
